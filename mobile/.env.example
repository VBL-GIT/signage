# ---- Mobile (Expo) environment ----
# Copy to .env for local dev. Production/staging values live in eas.json build profiles.
#
# Use a reachable host, NOT localhost:
#  - Physical device on LAN: your machine's LAN IP, e.g. http://192.168.1.10:3000
#  - Deployed backend:        https://api.signage.vbl.com
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
