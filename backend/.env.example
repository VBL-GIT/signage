# ---- Backend environment ----
# Copy to .env and fill in. Never commit the real .env.

# development | production | test
NODE_ENV=development
PORT=3000

# Postgres connection string. Avoid @ [ ] in the password (URL-encoding issues).
DATABASE_URL=postgresql://postgres:PASSWORD@db.HOST.supabase.co:5432/postgres

# JWT signing secrets. In production these MUST be >= 32 random chars and differ
# from each other. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_this_to_a_long_random_secret
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret

# Supabase project + storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=signage-photos

# Comma-separated allowed browser origins for the web console (CORS).
# Leave EMPTY in development (allows all). Set in production, e.g.:
#   ALLOWED_ORIGINS=https://signage.vbl.com
ALLOWED_ORIGINS=

# Max pooled Postgres connections (raise for production traffic).
DB_POOL_MAX=10

# ---- Outbound email (credential delivery) ----
# Optional: if unset, accounts are still created but no email is sent.
# For Gmail: host=smtp.gmail.com, port=465, user=<your@gmail.com>,
# pass=<16-char App Password> (create at https://myaccount.google.com/apppasswords
# with 2FA on — a normal Gmail password will NOT work).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From address shown to recipients (defaults to SMTP_USER).
SMTP_FROM=
# Verify recipient domain can receive mail (DNS MX) before creating the account.
EMAIL_VERIFY_MX=false
# Login URL included in the credential email (defaults to first ALLOWED_ORIGINS entry).
APP_WEB_URL=
