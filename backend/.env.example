# ---- Backend environment ----
# Copy to .env and fill in. Never commit the real .env.

# development | production | test
NODE_ENV=development
PORT=3000

# Postgres connection string. Avoid @ [ ] in the password (URL-encoding issues).
DATABASE_URL=postgresql://postgres:PASSWORD@db.HOST.supabase.co:5432/postgres

# JWT signing secrets. In production these MUST be >= 32 random chars and differ
# from each other. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_this_to_a_long_random_secret
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret

# Supabase project + storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=signage-photos

# Comma-separated allowed browser origins for the web console (CORS).
# Leave EMPTY in development (allows all). Set in production, e.g.:
#   ALLOWED_ORIGINS=https://signage.vbl.com
ALLOWED_ORIGINS=

# Max pooled Postgres connections (raise for production traffic).
DB_POOL_MAX=10

# ---- Outbound email (account setup, vendor welcome, password reset) ----
# Sent via Resend's HTTPS API, NOT raw SMTP: cloud hosts (Render included) get
# silently throttled or blocked on outbound SMTP to relays like Gmail's, which
# an HTTPS API sidesteps entirely. There is no SMTP_* support — those variables
# are not read by the application.
#
# Entirely optional. With RESEND_API_KEY unset, everything still works —
# accounts are created, vendors are registered, reset tokens are issued — but
# no email is delivered and the API reports email_sent: false. Set it to
# actually deliver mail.
#
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# From address shown to recipients. MUST be on a domain verified with Resend
# (https://resend.com/domains), e.g. "VBL Signage <signage@yourcompany.com>".
# Leaving this unset falls back to Resend's sandbox sender
# (onboarding@resend.dev), which ONLY delivers to the Resend account owner's
# own address — fine for a first smoke test, not usable in production.
RESEND_FROM=

# Verify a recipient's domain can actually receive mail (DNS MX lookup) before
# creating the account. Off by default so demo domains (e.g. @test.com) work.
# Applies to both single and bulk account creation.
EMAIL_VERIFY_MX=false

# Base URL of the web console, used to build the links in account-setup and
# password-reset emails. Defaults to the first ALLOWED_ORIGINS entry.
# Must be set (here or via ALLOWED_ORIGINS) or those emails contain a bare path.
APP_WEB_URL=
